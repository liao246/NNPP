        <mxCell id="dbN1Ni6q7ouI_jTukAtI-57" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" value="&lt;b&gt;5 step requantization:&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;1. acc1&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; (from step 4 above)&lt;/div&gt;&lt;div&gt;2. round:&amp;nbsp; acc1_round = acc1 + 2^(SHIFT1-1)&lt;/div&gt;&lt;div&gt;3. shift:&amp;nbsp; acc1_shift = acc1_round &amp;gt;&amp;gt;&amp;gt; SHIFT1&lt;/div&gt;&lt;div&gt;4. clamp:&amp;nbsp; acc1_clamp = clamp(acc1_shift, -128, 127)&lt;/div&gt;&lt;div&gt;5. ReLU:&amp;nbsp; &amp;nbsp;a1[j] = (acc1_clamp &amp;lt; 0) ? 0 : acc1_clamp&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="260" width="260" x="1801" y="250" as="geometry" />
