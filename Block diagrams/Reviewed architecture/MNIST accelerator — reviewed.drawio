        <mxCell id="p5-note7-body0" value="CLEAR → FILL_0 sets q=0. FILL_0: q=0; FILL_1: q=1." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p5-note7">
          <mxGeometry as="geometry" x="18" y="40" width="934" height="24" />
        </mxCell>
        <mxCell id="p5-note7-body1" value="ACCUMULATE: q=2…N_IN+1; exactly N_IN products commit." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p5-note7">
          <mxGeometry as="geometry" x="18" y="63" width="934" height="24" />
        </mxCell>
        <mxCell id="p5-note7-body2" value="weights_done = (q == N_IN+1). Address i=min(q,N_IN−1)." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p5-note7">
