          <mxGeometry as="geometry" x="0" y="0" width="965" height="175" />
        </mxCell>
        <mxCell id="p3-note10-title" value="State and output contract" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p3-note10">
          <mxGeometry as="geometry" x="18" y="8" width="929" height="26" />
        </mxCell>
        <mxCell id="p3-note10-rule" value="" style="fillColor=#94a3b8;strokeColor=none;opacity=25;" vertex="1" parent="p3-note10">
          <mxGeometry as="geometry" x="16" y="37" width="933" height="1" />
        </mxCell>
        <mxCell id="p3-note10-body0" value="state / next_state: 4 bits. All six outputs are listed in every state." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note10">
          <mxGeometry as="geometry" x="18" y="40" width="929" height="24" />
        </mxCell>
        <mxCell id="p3-note10-body1" value="start is an input; it is accepted only in IDLE or DONE." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note10">
          <mxGeometry as="geometry" x="18" y="63" width="929" height="24" />
        </mxCell>
        <mxCell id="p3-note10-body2" value="Unrecognized state: next_state = IDLE, outputs = 0." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note10">
          <mxGeometry as="geometry" x="18" y="86" width="929" height="24" />
        </mxCell>
        <mxCell id="p3-note10-body3" value="Each *_START unconditionally advances on the next rising edge." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note10">
          <mxGeometry as="geometry" x="18" y="109" width="929" height="24" />
        </mxCell>
        <mxCell id="p3-note11" value="" style="group;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1160" y="970" width="935" height="175" />
        </mxCell>
        <mxCell id="p3-note11-bg" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;arcSize=8;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="0" y="0" width="935" height="175" />
        </mxCell>
        <mxCell id="p3-note11-title" value="Result contract" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="18" y="8" width="899" height="26" />
        </mxCell>
        <mxCell id="p3-note11-rule" value="" style="fillColor=#94a3b8;strokeColor=none;opacity=25;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="16" y="37" width="903" height="1" />
        </mxCell>
        <mxCell id="p3-note11-body0" value="argmax_valid and argmax_digit are aligned." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="18" y="40" width="899" height="24" />
        </mxCell>
        <mxCell id="p3-note11-body1" value="The edge leaving ARGMAX_WAIT captures pred_digit and correct." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="18" y="63" width="899" height="24" />
        </mxCell>
        <mxCell id="p3-note11-body2" value="After that edge: done=1, busy=0, final cycle_count holds." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="18" y="86" width="899" height="24" />
        </mxCell>
        <mxCell id="p3-note11-body3" value="In DONE, start goes directly to FC1_START; no extra button press." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p3-note11">
          <mxGeometry as="geometry" x="18" y="109" width="899" height="24" />
        </mxCell>
