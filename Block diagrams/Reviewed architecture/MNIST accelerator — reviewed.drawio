        <mxCell id="p8-t3" value="08 · Timing &amp;amp; mapping" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#64748b;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1860" y="1397" width="239.0" height="27" />
