        </mxCell>
        <mxCell id="p8-note1-rule" value="" style="fillColor=#94a3b8;strokeColor=none;opacity=25;" vertex="1" parent="p8-note1">
          <mxGeometry as="geometry" x="16" y="37" width="618" height="1" />
        </mxCell>
        <mxCell id="p8-note1-body0" value="Per batch: CLEAR(1) + FILL(2) + MAC(N_IN)" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note1">
          <mxGeometry as="geometry" x="18" y="40" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note1-body1" value="                  + CAPTURE(1) = N_IN+4 cycles." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note1">
          <mxGeometry as="geometry" x="18" y="63" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note1-body2" value="FC1: 4 × 200 = 800 cycles. FC2: 1 × 68 = 68." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note1">
          <mxGeometry as="geometry" x="18" y="86" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note1-body3" value="Top handshakes, requant and argmax add overhead." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note1">
          <mxGeometry as="geometry" x="18" y="109" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note1-body4" value="Final total depends on the chosen argmax latency." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note1">
          <mxGeometry as="geometry" x="18" y="132" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note2" value="" style="group;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1450" y="440" width="650" height="185" />
        </mxCell>
        <mxCell id="p8-note2-bg" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;arcSize=8;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="0" y="0" width="650" height="185" />
        </mxCell>
        <mxCell id="p8-note2-title" value="Counter terminal rules" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="18" y="8" width="614" height="26" />
        </mxCell>
        <mxCell id="p8-note2-rule" value="" style="fillColor=#94a3b8;strokeColor=none;opacity=25;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="16" y="37" width="618" height="1" />
        </mxCell>
        <mxCell id="p8-note2-body0" value="q ranges 0…N_IN+1; hold at terminal." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="18" y="40" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note2-body1" value="weights_done = (q == N_IN+1)." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="18" y="63" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note2-body2" value="batch ranges 0…B−1; hold at terminal." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="18" y="86" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-note2-body3" value="batches_done = (batch == B−1)." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note2">
          <mxGeometry as="geometry" x="18" y="109" width="614" height="24" />
        </mxCell>
        <mxCell id="p8-mapping" value="" style="group;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="735" width="1110" height="230" />
        </mxCell>
        <mxCell id="p8-mapping-bg" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;arcSize=8;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="0" y="0" width="1110" height="230" />
        </mxCell>
        <mxCell id="p8-mapping-title" value="Contiguous lane ownership — use the same n everywhere" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="18" y="12" width="1074" height="28" />
        </mxCell>
        <mxCell id="p8-mapping-rule" value="" style="fillColor=#2563eb;strokeColor=none;opacity=25;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="16" y="46" width="1078" height="1" />
        </mxCell>
        <mxCell id="p8-mapping-body0" value="n = lane × B + batch; B = ceil(N_OUT / LANES)" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="18" y="50" width="1074" height="26" />
        </mxCell>
        <mxCell id="p8-mapping-body1" value="FC1: lane 0 → neurons 0,1,2,3; lane 1 → 4,5,6,7; lane 15 → 60,61,62,63." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="18" y="75" width="1074" height="26" />
        </mxCell>
        <mxCell id="p8-mapping-body2" value="Local weight address = batch × N_IN + i; local bias address = batch." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="18" y="100" width="1074" height="26" />
        </mxCell>
        <mxCell id="p8-mapping-body3" value="Capture destination = acc_out[n]; valid lane result if n &lt; N_OUT." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="18" y="125" width="1074" height="26" />
        </mxCell>
        <mxCell id="p8-mapping-body4" value="FC2: B=1; n=lane; only lanes 0…9 write scores." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-mapping">
          <mxGeometry as="geometry" x="18" y="150" width="1074" height="26" />
        </mxCell>
        <mxCell id="p8-widths" value="" style="group;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1320" y="735" width="780" height="230" />
        </mxCell>
        <mxCell id="p8-widths-bg" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;strokeWidth=2;arcSize=8;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="0" y="0" width="780" height="230" />
        </mxCell>
        <mxCell id="p8-widths-title" value="Widths — FC1 / FC2" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="18" y="12" width="744" height="28" />
        </mxCell>
        <mxCell id="p8-widths-rule" value="" style="fillColor=#2563eb;strokeColor=none;opacity=25;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="16" y="46" width="748" height="1" />
        </mxCell>
        <mxCell id="p8-widths-body0" value="Activation address: 8 / 6; q: 8 / 7." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="18" y="50" width="744" height="26" />
        </mxCell>
        <mxCell id="p8-widths-body1" value="Batch and bias address: 2 / 1 (guard B=1 width)." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="18" y="75" width="744" height="26" />
        </mxCell>
        <mxCell id="p8-widths-body2" value="Local weight address: 10 / 6; weight data: signed 8." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="18" y="100" width="744" height="26" />
        </mxCell>
        <mxCell id="p8-widths-body3" value="Activation operand: signed 9 with top bit zero." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="18" y="125" width="744" height="26" />
        </mxCell>
        <mxCell id="p8-widths-body4" value="Product: signed 17; accumulator and bias: signed 32." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontColor=#334155;" vertex="1" parent="p8-widths">
          <mxGeometry as="geometry" x="18" y="150" width="744" height="26" />
        </mxCell>
        <mxCell id="p8-note5" value="" style="group;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1080" width="1020" height="220" />
        </mxCell>
        <mxCell id="p8-note5-bg" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;arcSize=8;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="0" y="0" width="1020" height="220" />
        </mxCell>
        <mxCell id="p8-note5-title" value="Request / result rules" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="18" y="8" width="984" height="26" />
        </mxCell>
        <mxCell id="p8-note5-rule" value="" style="fillColor=#94a3b8;strokeColor=none;opacity=25;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="16" y="37" width="988" height="1" />
        </mxCell>
        <mxCell id="p8-note5-body0" value="Only accept start in IDLE or DONE; ignore start while busy." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="18" y="40" width="984" height="24" />
        </mxCell>
        <mxCell id="p8-note5-body1" value="Latch min(img_idx,19) on accept_start. Image and label stay associated." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="18" y="63" width="984" height="24" />
        </mxCell>
        <mxCell id="p8-note5-body2" value="Top done stays high in DONE; FC-layer done is a one-cycle pulse." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="18" y="86" width="984" height="24" />
        </mxCell>
        <mxCell id="p8-note5-body3" value="argmax_valid captures both pred_digit and correct on the DONE-entry edge." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="18" y="109" width="984" height="24" />
        </mxCell>
        <mxCell id="p8-note5-body4" value="Counter clears on accepted start, counts busy cycles, then holds." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note5">
          <mxGeometry as="geometry" x="18" y="132" width="984" height="24" />
        </mxCell>
        <mxCell id="p8-note6" value="" style="group;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="1080" width="910" height="220" />
        </mxCell>
        <mxCell id="p8-note6-bg" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=2;arcSize=8;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="0" y="0" width="910" height="220" />
        </mxCell>
        <mxCell id="p8-note6-title" value="Argmax / debug / reset rules" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="18" y="8" width="874" height="26" />
