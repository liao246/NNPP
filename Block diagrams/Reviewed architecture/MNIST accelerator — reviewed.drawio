        <mxCell id="p5-note8-body1" value="The capture edge increments batch only if another batch remains." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p5-note8">
