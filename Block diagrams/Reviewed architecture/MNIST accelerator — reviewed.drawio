        <mxCell id="p4-note3-body0" value="q = weight_count; B = NUM_BATCHES; lane L is an elaboration index." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note3">
          <mxGeometry as="geometry" x="18" y="40" width="774" height="24" />
        </mxCell>
        <mxCell id="p4-note3-body1" value="QW=max(1, ceil(log2(N_IN+2))); BW=max(1, ceil(log2(B)))." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note3">
          <mxGeometry as="geometry" x="18" y="63" width="774" height="24" />
        </mxCell>
        <mxCell id="p4-note3-body2" value="AW=max(1, ceil(log2(N_IN))); WW=max(1, ceil(log2(B×N_IN)))." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note3">
          <mxGeometry as="geometry" x="18" y="86" width="774" height="24" />
        </mxCell>
        <mxCell id="p4-note3-body3" value="acc_clear loads bias; count_en advances q; acc_en permits a MAC." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note3">
          <mxGeometry as="geometry" x="18" y="109" width="774" height="24" />
        </mxCell>
        <mxCell id="p4-note3-body4" value="capture_valid is internal, one cycle per completed batch." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note3">
          <mxGeometry as="geometry" x="18" y="132" width="774" height="24" />
