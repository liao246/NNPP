        <mxCell id="p4-qn-body0" value="if acc_clear: next_q = 0" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=17;fontColor=#334155;" vertex="1" parent="p4-qn">
          <mxGeometry as="geometry" x="18" y="51" width="404" height="25" />
        </mxCell>
        <mxCell id="p4-qn-body1" value="else if count_en AND q &lt; N_IN+1:" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=17;fontColor=#334155;" vertex="1" parent="p4-qn">
          <mxGeometry as="geometry" x="18" y="75" width="404" height="25" />
        </mxCell>
        <mxCell id="p4-qn-body2" value="  next_q = q + 1" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=17;fontColor=#334155;" vertex="1" parent="p4-qn">
          <mxGeometry as="geometry" x="18" y="99" width="404" height="25" />
        </mxCell>
        <mxCell id="p4-qn-body3" value="else: next_q = q" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=17;fontColor=#334155;" vertex="1" parent="p4-qn">
          <mxGeometry as="geometry" x="18" y="123" width="404" height="25" />
        </mxCell>
        <mxCell id="p4-qn-body4" value="weights_done = (q == N_IN+1)" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=17;fontColor=#334155;" vertex="1" parent="p4-qn">
