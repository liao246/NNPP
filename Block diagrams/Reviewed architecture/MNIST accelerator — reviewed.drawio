          <mxGeometry as="geometry" x="16" y="37" width="878" height="1" />
        </mxCell>
        <mxCell id="p8-note6-body0" value="argmax compares signed scores; ties choose the smallest index." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="18" y="40" width="874" height="24" />
        </mxCell>
        <mxCell id="p8-note6-body1" value="Clocked argmax returns digit + valid together; latency must be ≥1 cycle." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="18" y="63" width="874" height="24" />
        </mxCell>
        <mxCell id="p8-note6-body2" value="If scanning: initialize max from score 0; update only on strict &gt;." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="18" y="86" width="874" height="24" />
        </mxCell>
        <mxCell id="p8-note6-body3" value="score_debug[32×c +: 32] = acc2[c]; each score interpreted signed." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="18" y="109" width="874" height="24" />
        </mxCell>
        <mxCell id="p8-note6-body4" value="All state/data/control registers reset to 0 except FSM reset state = IDLE." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p8-note6">
          <mxGeometry as="geometry" x="18" y="132" width="874" height="24" />
        </mxCell>
        <mxCell id="p8-t0" value="Timing, mapping &amp;amp; interface reference" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="13" width="716.0" height="42" />
        </mxCell>
        <mxCell id="p8-t1" value="Implementation contract for the corrected diagrams • review independently of old RTL" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=17;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="65" width="906.8" height="29" />
        </mxCell>
        <mxCell id="p8-t2" value="MNIST / 196 → 64 → 10  •  REVIEW COPY  •  All sequential blocks: common clk [1], synchronous rst [1] (reset wires omitted)." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=15;fontStyle=0;fontColor=#64748b;" vertex="1" parent="1">
