        </mxCell>
        <mxCell id="p4-note14-title" value="Counter and completion interfaces" style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="p4-note14">
