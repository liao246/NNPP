          <mxGeometry as="geometry" x="16" y="37" width="853" height="1" />
        </mxCell>
        <mxCell id="p4-note14-body0" value="weights_done [1] → next-state logic; batches_done [1] → next-state logic." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note14">
          <mxGeometry as="geometry" x="18" y="40" width="849" height="24" />
        </mxCell>
        <mxCell id="p4-note14-body1" value="busy [1], done [1] → FC-layer ports. acc_out array → top datapath." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note14">
          <mxGeometry as="geometry" x="18" y="63" width="849" height="24" />
        </mxCell>
        <mxCell id="p4-note14-body2" value="Counters update at the closing edge; capture uses the current batch." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note14">
          <mxGeometry as="geometry" x="18" y="86" width="849" height="24" />
        </mxCell>
        <mxCell id="p4-note14-body3" value="CLEAR resets q and loads the current bias. FILL_0/FILL_1 advance q." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note14">
          <mxGeometry as="geometry" x="18" y="109" width="849" height="24" />
        </mxCell>
        <mxCell id="p4-note14-body4" value="The final MAC commits at ACCUMULATE → CAPTURE." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note14">
          <mxGeometry as="geometry" x="18" y="132" width="849" height="24" />
        </mxCell>
        <mxCell id="p4-note14-body5" value="CAPTURE writes the stable sum one edge later, then advances batch." style="text;html=0;align=left;verticalAlign=top;spacing=0;whiteSpace=nowrap;strokeColor=none;fillColor=none;fontFamily=Segoe UI;fontSize=16;fontColor=#334155;" vertex="1" parent="p4-note14">
